{
  "name": "fidevoltz-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "latest",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "turbo": "latest"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cloudinary": "^2.8.0",
    "date-fns": "^4.1.0",
    "pg": "^8.16.3",
    "react-dropzone": "^14.3.8",
    "recharts": "^3.6.0"
  }
}
