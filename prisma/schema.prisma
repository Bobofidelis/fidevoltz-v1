generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(uuid())
  email                      String              @unique
  passwordHash               String
  name                       String?
  role                       Role                @default(USER)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  status                     String              @default("active")
  lastLoginAt                DateTime?
  loginCount                 Int                 @default(0)
  phoneNumber                String?
  address                    String?
  avatar                     String?
  bio                        String?
  banReason                  String?
  bannedAt                   DateTime?
  bannedBy                   String?
  isBanned                   Boolean             @default(false)
  lastWarningAt              DateTime?
  warningCount               Int                 @default(0)
  activityLogs               ActivityLog[]       @relation("ActivityLogs")
  advertisements             Advertisement[]     @relation("CreatedAds")
  analyticsEvents            AnalyticsEvent[]    @relation("AnalyticsEvents")
  cart                       Cart?
  comments                   Comment[]
  assignedContactSubmissions ContactSubmission[] @relation("AssignedContactSubmissions")
  receivedMessages           DirectMessage[]     @relation("ReceivedMessages")
  sentMessages               DirectMessage[]     @relation("SentMessages")
  uploadedMedia              Media[]             @relation("UploadedMedia")
  sentNotifications          Notification[]      @relation("SentNotifications")
  notifications              Notification[]      @relation("UserNotifications")
  orders                     Order[]
  orderHistory               OrderHistory[]
  orderMessages              OrderMessage[]
  orderNotes                 OrderNote[]
  pageViews                  PageView[]
  projects                   ProjectPost[]
  adminReplies               Review[]            @relation("AdminReplies")
  reviews                    Review[]            @relation("UserReviews")
  updatedSiteSettings        SiteSettings[]
  assignedTickets            SupportTicket[]     @relation("AssignedTickets")
  tickets                    SupportTicket[]
  ticketMessages             TicketMessage[]     @relation("TicketMessages")
  activities                 UserActivity[]
  settings                   UserSettings?

  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([role])
}

model ProjectPost {
  id            String              @id @default(uuid())
  title         String
  slug          String              @unique
  excerpt       String?
  content       Json?
  featuredImage String?
  category      String
  difficulty    String?             @default("Intermediate")
  status        String              @default("DRAFT")
  publishedAt   DateTime?
  allowComments Boolean             @default(true)
  authorId      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  comments      Comment[]
  attachments   ProjectAttachment[]
  components    ProjectComponent[]
  author        User                @relation(fields: [authorId], references: [id])
}

model ProjectComponent {
  id        String      @id @default(uuid())
  projectId String
  productId String?
  name      String
  quantity  Int         @default(1)
  product   Product?    @relation(fields: [productId], references: [id])
  project   ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAttachment {
  id        String      @id @default(uuid())
  projectId String
  name      String
  url       String
  size      Int?
  type      String
  project   ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String        @id @default(uuid())
  content    String
  userId     String
  postId     String
  parentId   String?
  isAdmin    Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  adminReply String?
  flagReason String?
  flaggedAt  DateTime?
  flaggedBy  String?
  isFlagged  Boolean       @default(false)
  repliedAt  DateTime?
  repliedBy  String?
  status     CommentStatus @default(PENDING)
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  post       ProjectPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([postId])
  @@index([status])
  @@index([isFlagged])
  @@index([createdAt])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id                String             @id @default(uuid())
  name              String
  description       String
  price             Decimal
  stock             Int
  minStock          Int                @default(0)
  sku               String?            @unique
  image             String?
  images            String[]           @default([])
  datasheet         String?
  specifications    Json?
  tags              String[]           @default([])
  status            ProductStatus      @default(DRAFT)
  allowReviews      Boolean            @default(true)
  costPrice         Decimal?
  currency          String             @default("NGN")
  categoryId        String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  category          Category           @relation(fields: [categoryId], references: [id])
  projectComponents ProjectComponent[]
  reviews           Review[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id                 String         @id @default(uuid())
  userId             String
  totalAmount        Decimal
  paymentGateway     String
  paymentStatus      String
  status             OrderStatus    @default(PENDING)
  trackingNumber     String?
  shippingAddress    String?
  carrier            String?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id])
  history            OrderHistory[]
  items              OrderItem[]
  messages           OrderMessage[]
  notes              OrderNote[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model OrderNote {
  id         String   @id @default(uuid())
  orderId    String
  userId     String
  note       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}

model OrderHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  changedBy String?
  note      String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [changedBy], references: [id])
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderMessage {
  id        String   @id @default(uuid())
  orderId   String
  senderId  String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])
}

model AdSetting {
  id        String   @id @default(uuid())
  platform  String
  adCode    String
  isActive  Boolean  @default(true)
  placement String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id            String          @id @default(uuid())
  subject       String
  userEmail     String
  userId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  assignedTo    String?
  closedAt      DateTime?
  description   String
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  assignedAdmin User?           @relation("AssignedTickets", fields: [assignedTo], references: [id])
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  title       String
  message     String
  userId      String?
  isRead      Boolean          @default(false)
  actionUrl   String?
  actionLabel String?
  metadata    Json?
  priority    String           @default("normal")
  sentBy      String?
  isBroadcast Boolean          @default(false)
  readAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sender      User?            @relation("SentNotifications", fields: [sentBy], references: [id])
  user        User?            @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model DirectMessage {
  id          String    @id @default(uuid())
  senderId    String
  recipientId String
  subject     String?
  message     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([createdAt])
  @@index([isRead])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id           String       @id @default(uuid())
  productId    String
  userId       String
  rating       Int
  title        String?
  comment      String
  status       ReviewStatus @default(PENDING)
  adminReply   String?
  repliedAt    DateTime?
  repliedBy    String?
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  adminUser    User?        @relation("AdminReplies", fields: [repliedBy], references: [id])
  user         User         @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation("TicketMessages", fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model Advertisement {
  id            String        @id @default(cuid())
  name          String
  type          AdType        @default(CUSTOM)
  format        AdFormat
  status        AdStatus      @default(DRAFT)
  title         String?
  description   String?
  imageUrl      String?
  customHtml    String?
  customCss     String?
  linkUrl       String?
  ctaText       String?
  startDate     DateTime?
  endDate       DateTime?
  targetPages   String[]
  targetDevices String[]
  impressions   Int           @default(0)
  clicks        Int           @default(0)
  conversions   Int           @default(0)
  revenue       Float         @default(0)
  isGoogleAd    Boolean       @default(false)
  googleAdId    String?
  googleAdSlot  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String
  placements    AdPlacement[]
  creator       User          @relation("CreatedAds", fields: [createdBy], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdBy])
}

model AdPlacement {
  id              String        @id @default(cuid())
  advertisementId String
  page            String
  zone            AdZone
  position        Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([page])
  @@index([zone])
  @@index([advertisementId])
}

model SEOMetrics {
  id              String    @id @default(cuid())
  page            String    @unique
  title           String?
  description     String?
  keywords        String[]
  ogImage         String?
  pageViews       Int       @default(0)
  uniqueVisitors  Int       @default(0)
  avgTimeOnPage   Float     @default(0)
  bounceRate      Float     @default(0)
  seoScore        Int       @default(0)
  mobileScore     Int       @default(0)
  speedScore      Int       @default(0)
  keywordRankings Json?
  lastCrawled     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([page])
}

model GoogleAdsConfig {
  id           String    @id @default(cuid())
  clientId     String    @unique
  clientSecret String
  refreshToken String?
  customerId   String?
  accountName  String?
  isActive     Boolean   @default(false)
  lastSync     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  path      String
  referrer  String?
  userAgent String?
  userId    String?
  sessionId String
  duration  Int?
  country   String?
  city      String?
  device    String?
  browser   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([page])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model UserActivity {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  resource   String?
  resourceId String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model DailyMetrics {
  id             String   @id @default(cuid())
  date           DateTime @unique
  totalRevenue   Float    @default(0)
  totalOrders    Int      @default(0)
  totalVisitors  Int      @default(0)
  uniqueVisitors Int      @default(0)
  pageViews      Int      @default(0)
  newUsers       Int      @default(0)
  conversionRate Float    @default(0)
  avgOrderValue  Float    @default(0)
  bounceRate     Float    @default(0)
  avgSessionTime Int      @default(0)
  topProducts    Json?
  topPages       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

model Media {
  id          String        @id @default(uuid())
  provider    MediaProvider @default(CLOUDINARY)
  type        MediaType
  publicId    String
  url         String
  secureUrl   String?
  format      String?
  width       Int?
  height      Int?
  duration    Float?
  bytes       Int?
  folder      String?
  tags        String[]
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  creator     User          @relation("UploadedMedia", fields: [createdById], references: [id])

  @@index([provider])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model MediaProviderConfig {
  id        String        @id @default(uuid())
  provider  MediaProvider
  config    Json
  isActive  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([provider])
  @@index([isActive])
}

model ContactSubmission {
  id           String                  @id @default(cuid())
  type         ContactSubmissionType
  status       ContactSubmissionStatus @default(NEW)
  name         String
  email        String
  organization String?
  subject      String
  message      String
  projectType  String?
  budget       String?
  interestType String?
  assignedToId String?
  notes        String?
  adminReply   String?
  repliedAt    DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  assignedTo   User?                   @relation("AssignedContactSubmissions", fields: [assignedToId], references: [id])

  @@index([type])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([assignedToId])
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  orderNotifications   Boolean  @default(true)
  messageNotifications Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  digestFrequency      String   @default("daily")
  profileVisibility    String   @default("public")
  showEmail            Boolean  @default(false)
  showPhone            Boolean  @default(false)
  language             String   @default("en")
  timezone             String   @default("UTC")
  theme                String   @default("light")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SiteSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  value         Json
  category      String
  description   String?
  isPublic      Boolean  @default(true)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedByUser User?    @relation(fields: [updatedBy], references: [id])

  @@index([category])
  @@index([key])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation("AnalyticsEvents", fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  userId     String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation("ActivityLogs", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     Json
  isPublished Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

enum MediaProvider {
  CLOUDINARY
  AWS_S3
  LOCAL
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum NotificationType {
  ORDER
  PRODUCT
  COMMENT
  SYSTEM
  MESSAGE
  ANNOUNCEMENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AdType {
  CUSTOM
  GOOGLE_ADS
  AFFILIATE
}

enum AdFormat {
  BANNER
  SIDEBAR
  POPUP
  INLINE
  STICKY
  INTERSTITIAL
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  SCHEDULED
  EXPIRED
}

enum AdZone {
  HEADER
  SIDEBAR_LEFT
  SIDEBAR_RIGHT
  CONTENT_TOP
  CONTENT_MIDDLE
  CONTENT_BOTTOM
  FOOTER
  POPUP
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum ContactSubmissionType {
  GENERAL
  SERVICE
  PARTNERSHIP
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}
